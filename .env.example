# MediBook — Environment Variables
# Copy this file to .env and fill in your Supabase credentials.
# NEVER commit your real .env file to Git.

# Supabase Project URL — found in: Project Settings > API > Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous (public) Key — found in: Project Settings > API > Project API keys > anon public
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
